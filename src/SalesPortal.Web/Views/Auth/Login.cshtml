@model LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-page">
    <section class="auth-split" aria-label="Inicio de sesión SOLSAP CUP">
        <div class="auth-brand-panel">
            <div class="auth-brand-content">
                <div class="auth-logo-wrapper">
                    <img class="auth-logo" src="~/img/solsapcuplogosf.png" alt="SOLSAP CUP" asp-append-version="true" />
                </div>
                <p class="auth-slogan">Vive la pasión de la copa y gestiona cada partido en un solo lugar.</p>
            </div>
        </div>

        <div class="auth-login-panel">
            <div class="login-card">
                <div class="login-header">
                    <h2>Bienvenido</h2>
                </div>

                <form asp-action="Login" asp-controller="Auth" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="form-group">
                        <input asp-for="UserOrEmail"
                               class="form-control"
                               placeholder="Usuario o correo electrónico" />
                        <span asp-validation-for="UserOrEmail" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="Password"
                               class="form-control"
                               placeholder="Contraseña" />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-login">
                        Iniciar sesión
                    </button>
                </form>
            </div>
        </div>
    </section>

