@model ChangePasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="auth-page auth-password-page">
    <section class="auth-split" aria-label="Cambio de contraseña SOLSAP CUP">
        <div class="auth-brand-panel auth-password-brand-panel">
            <div class="auth-brand-content auth-password-brand-content">
                <div class="auth-logo-wrapper">
                    <img class="auth-logo" src="~/img/solsapcuplogosf.png" alt="SOLSAP CUP" asp-append-version="true" />
                </div>
                <p class="auth-slogan">Protege tu cuenta antes de volver a la copa.</p>
                <div class="auth-password-details" aria-label="Requisitos de seguridad">
                    <span>Actualización obligatoria</span>
                    <strong>Usa una contraseña nueva, segura y fácil de recordar.</strong>
                </div>
            </div>
        </div>

        <div class="auth-login-panel auth-password-panel">
            <div class="login-card password-card">
                <div class="login-header password-header">
                    <h2>Nueva contraseña</h2>
                    <p>Ingresa una contraseña segura para continuar.</p>
                </div>

                <form asp-action="ChangePassword" asp-controller="Auth" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="CardCode" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="form-group">
                        <label asp-for="NewPassword"></label>
                        <input asp-for="NewPassword" class="form-control" placeholder="Nueva contraseña" />
                        <span asp-validation-for="NewPassword" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar contraseña" />
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-login">
                        Actualizar contraseña
                    </button>
                </form>
            </div>
        </div>
    </section>
</div>
