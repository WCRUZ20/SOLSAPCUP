@model ChangePasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="auth-page">
    <div class="auth-left">
        <div class="auth-brand">
            <div class="brand-line"></div>
            <h1>Cambio obligatorio</h1>
            <p>Por seguridad debe actualizar su contraseña antes de continuar.</p>
        </div>
    </div>

    <div class="auth-right">
        <div class="login-card">
            <div class="login-header">
                <h2>Nueva contraseña</h2>
                <p>Ingrese una contraseña segura para su próximo inicio de sesión.</p>
            </div>

            <form asp-action="ChangePassword" asp-controller="Auth" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="CardCode" />

                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" class="form-control" placeholder="Nueva contraseña" />
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar contraseña" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn-login">
                    Actualizar contraseña
                </button>
            </form>
        </div>
    </div>
</div>