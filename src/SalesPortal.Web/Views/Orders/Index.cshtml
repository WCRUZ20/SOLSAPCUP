@model SalesPortal.Web.Models.Orders.OrderListViewModel
@using SalesPortal.Shared.Security
@using System.Security.Claims

@{
    ViewData["Title"] = "Lista pedidos";
    var draftKey = $"salesportal:last-order-draft:{User.FindFirstValue(PortalClaimTypes.CardCode) ?? "default"}";
    var shouldClearDraft = TempData["ClearOrderDraft"] != null;
}

<div class="section-title orders-title">
    @* <div>
        <span class="eyebrow">Pedidos de clientes - ORDR</span>
        <h2>Lista pedidos</h2>
    </div> *@
    <div class="order-actions-cell">
        <a class="btn btn-light" asp-controller="Orders" asp-action="BulkUpload">Carga masiva pedidos</a>
        <a class="btn btn-primary" asp-controller="Orders" asp-action="Create">Crear pedido</a>
    </div>
</div>

<form class="filters-panel" asp-controller="Orders" asp-action="Index" method="get">
    <div class="filter-field">
        <label asp-for="DateFrom"></label>
        <input asp-for="DateFrom" type="date" />
    </div>

    <div class="filter-field">
        <label asp-for="DateTo"></label>
        <input asp-for="DateTo" type="date" />
        <span asp-validation-for="DateTo" class="field-validation-error"></span>
    </div>

    <div class="filter-field">
        <label asp-for="DocNum"></label>
        <input asp-for="DocNum" type="number" min="1" placeholder="Ej. 100245" />
    </div>

    <div class="filter-actions">
        <button type="submit" class="btn btn-dark">Filtrar</button>
        <a class="btn btn-light" asp-controller="Orders" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="table-wrapper orders-grid">
    <table>
        <thead>
            <tr>
                <th>#Num pedido</th>
                <th>Fecha pedido</th>
                <th>Valor del pedido</th>
                <th>Estado</th>
                <th>Comentario pedido</th>
                <th>Dirección envío</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Orders.Count == 0)
            {
                <tr>
                    <td colspan="7" class="empty-row">No se encontraron pedidos con los filtros seleccionados.</td>
                </tr>
            }
            else
            {
                foreach (var order in Model.Orders)
                {
                    <tr>
                        <td class="text-strong">@order.DocNum</td>
                        <td>@order.DocDate.ToString("dd/MM/yyyy")</td>
                        <td>@order.DocTotal.ToString("C")</td>
                        <td>@(string.IsNullOrWhiteSpace(order.Status) ? "Sin estado" : order.Status)</td>
                        <td>@(string.IsNullOrWhiteSpace(order.Comments) ? "Sin comentario" : order.Comments)</td>
                        <td>@(string.IsNullOrWhiteSpace(order.ShippingAddress) ? "Sin dirección" : order.ShippingAddress)</td>
                        <td>
                            <div class="order-actions-cell">
                                <a class="btn btn-outline" asp-controller="Orders" asp-action="Preview" asp-route-docEntry="@order.DocEntry">Ver orden</a>
                                <button type="button" class="btn btn-outline" disabled>Ver factura</button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (shouldClearDraft)
    {
        <script>
            localStorage.removeItem(@Json.Serialize(draftKey));
        </script>
    }
}
