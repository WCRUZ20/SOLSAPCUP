@model SalesPortal.Web.Models.Orders.OrderPreviewViewModel
@using System.Globalization

@{
    ViewData["Title"] = $"Previsualizar orden #{Model.DocNum}";
    var culture = CultureInfo.GetCultureInfo("es-DO");
}

<div class="section-title orders-title">
    <div>
        <span class="eyebrow">Solo visualización</span>
        <h2>Orden #@Model.DocNum</h2>
    </div>
    <a class="btn btn-light" asp-controller="Orders" asp-action="Index">Volver al listado</a>
</div>

<div class="readonly-notice" role="status">
    Esta previsualización es de solo lectura. No permite modificar la orden creada.
</div>

<section class="order-card order-preview-card">
    <div class="order-card-header">
        <div>
            <span class="eyebrow">Información general</span>
            <h3>Resumen de la orden</h3>
        </div>
        <span class="step-summary">@(string.IsNullOrWhiteSpace(Model.Status) ? "Sin estado" : Model.Status)</span>
    </div>

    <dl class="order-preview-grid">
        <div>
            <dt>#Num pedido</dt>
            <dd>@Model.DocNum</dd>
        </div>
        <div>
            <dt>Fecha pedido</dt>
            <dd>@Model.DocDate.ToString("dd/MM/yyyy")</dd>
        </div>
        <div>
            <dt>Valor del pedido</dt>
            <dd>@Model.DocTotal.ToString("C", culture)</dd>
        </div>
        <div>
            <dt>Dirección envío</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.ShippingAddress) ? "Sin dirección" : Model.ShippingAddress)</dd>
        </div>
        <div class="order-preview-grid-wide">
            <dt>Comentario pedido</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Comments) ? "Sin comentario" : Model.Comments)</dd>
        </div>
    </dl>
</section>

<section class="order-card order-preview-card">
    <div class="order-card-header">
        <div>
            <span class="eyebrow">Detalle</span>
            <h3>Líneas de la orden</h3>
        </div>
        <span class="step-summary">@Model.Lines.Count @(Model.Lines.Count == 1 ? "línea" : "líneas")</span>
    </div>

    <div class="table-wrapper orders-grid order-lines-wrapper">
        <table>
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Descripción</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>Descuento</th>
                    <th>Total línea</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Lines.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-row">No se encontraron líneas para esta orden.</td>
                    </tr>
                }
                else
                {
                    foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td class="text-strong">@line.ItemCode</td>
                            <td>@(string.IsNullOrWhiteSpace(line.Description) ? "Sin descripción" : line.Description)</td>
                            <td>@line.Quantity.ToString("N2", culture)</td>
                            <td>@line.UnitPrice.ToString("C", culture)</td>
                            <td>@line.DiscountPercent.ToString("N2", culture)%</td>
                            <td>@line.LineTotal.ToString("C", culture)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
