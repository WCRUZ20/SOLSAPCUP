@model SalesPortal.Web.Models.Home.DashboardViewModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="dashboard-hero cup-hero">
    <div>
        <span class="eyebrow">Resumen competición</span>
        <h2>Hola, @Model.UserName</h2>
        <p>Rol: <strong>@Model.RoleName</strong> · País: <strong>@Model.CountryName</strong></p>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.CountryFlagPath))
    {
        <div class="hero-country-card" aria-label="País asignado: @Model.CountryName">
            <img src="@Model.CountryFlagPath" alt="Bandera de @Model.CountryName" class="country-flag country-flag-hero" onerror="this.closest('.hero-country-card').style.display='none';" />
            <span>@Model.CountryName</span>
        </div>
    }
</div>

<div class="dashboard-grid dashboard-grid-four">
    <div class="stat-card stat-card-accent">
        <span>Puntos</span>
        <strong>@Model.PlayerPoints.ToString("0")</strong>
        <p>Puntaje actual del jugador.</p>
    </div>
    <div class="stat-card">
        <span>Partidos</span>
        <strong>@Model.PlayerMatches.ToString("0")</strong>
        <p>Partidos registrados.</p>
    </div>
    <div class="stat-card">
        <span>Goles a favor</span>
        <strong>@Model.GoalsFor.ToString("0")</strong>
        <p>Calculados según resultados.</p>
    </div>
    <div class="stat-card">
        <span>Goles en contra</span>
        <strong>@Model.GoalsAgainst.ToString("0")</strong>
        <p>Diferencia: @Model.PlayerGoalDifference.ToString("+0;-0;0")</p>
    </div>
</div>

<div class="analytics-grid">
    <section class="analytics-card">
        <div class="section-title compact-title">
            <div>
                <span class="eyebrow">Tabla</span>
                <h2>Tabla de posiciones</h2>
            </div>
        </div>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Pos.</th>
                        <th>Jugador</th>
                        <th>Equipo</th>
                        <th>PJ</th>
                        <th>GF</th>
                        <th>GC</th>
                        <th>DG</th>
                        <th>Pts</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Standings.Count == 0)
                    {
                        <tr><td colspan="9" class="empty-row">Aún no hay competidores registrados.</td></tr>
                    }
                    else
                    {
                        foreach (var row in Model.Standings)
                        {
                            <tr class="@(row.IsCurrentUser ? "current-player-row" : string.Empty)">
                                <td class="text-strong">@(row.Position == 0 ? "--" : row.Position.ToString("0"))</td>
                                <td>@row.Name</td>
                                <td>@row.Team</td>
                                <td>@row.Matches.ToString("0")</td>
                                <td>@row.GoalsFor.ToString("0")</td>
                                <td>@row.GoalsAgainst.ToString("0")</td>
                                <td>@row.GoalDifference.ToString("+0;-0;0")</td>
                                <td class="text-strong">@row.Points.ToString("0")</td>
                                <td>@(string.IsNullOrWhiteSpace(row.Status) ? "Activo" : row.Status)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="analytics-card">
        <div class="section-title compact-title">
            <div>
                <span class="eyebrow">Ataque</span>
                <h2>Goles a favor</h2>
            </div>
        </div>
        @if (Model.GoalChart.Count == 0)
        {
            <div class="dashboard-empty-state">No hay resultados para graficar.</div>
        }
        else
        {
            <div class="status-list">
                @foreach (var row in Model.GoalChart)
                {
                    <div class="status-row">
                        <div class="status-row-header">
                            <strong>@row.Team</strong>
                            <span>@row.GoalsFor.ToString("0") goles</span>
                        </div>
                        <div class="progress-track" aria-hidden="true">
                            <span style="width: @row.Percentage%"></span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>
