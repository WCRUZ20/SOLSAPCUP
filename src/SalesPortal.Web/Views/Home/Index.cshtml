@model SalesPortal.Web.Models.Home.DashboardViewModel

@{
    ViewData["Title"] = "Inicio";
    var assignedCountryName = TempData["AssignedCountryName"]?.ToString();
    var assignedCountryCode = TempData["AssignedCountryCode"]?.ToString();
    var showAssignmentPopup = !string.IsNullOrWhiteSpace(assignedCountryName) && !string.IsNullOrWhiteSpace(assignedCountryCode);
    var assignedFlagUrl = showAssignmentPopup
        ? Url.Content($"~/img/banderas/{System.Uri.EscapeDataString(assignedCountryCode ?? string.Empty)}.png")
        : string.Empty;
    var userFlagUrl = string.IsNullOrWhiteSpace(Model.CountryFlagFileName)
        ? string.Empty
        : Url.Content($"~/img/banderas/{System.Uri.EscapeDataString(Model.CountryCode)}.png");
}

@if (showAssignmentPopup)
{
    <div class="country-assignment-modal" id="countryAssignmentModal" role="dialog" aria-modal="true" aria-labelledby="countryAssignmentTitle">
        <div class="country-assignment-dialog">
            <button type="button" class="country-assignment-close" aria-label="Cerrar mensaje de país asignado" data-close-country-modal>×</button>
            <span class="eyebrow">País asignado</span>
            <img class="country-assignment-flag" src="@assignedFlagUrl" alt="Bandera de @assignedCountryName" />
            <h2 id="countryAssignmentTitle">¡Se te ha asignado @assignedCountryName!</h2>
            <p>Este será tu país para participar en SOLSAP CUP.</p>
            <button type="button" class="btn btn-primary" data-close-country-modal>Entendido</button>
        </div>
    </div>
}

<div class="dashboard-hero cup-hero">
    <div>
        <span class="eyebrow">Resumen competición</span>
        <h2>Hola, @Model.UserName</h2>
        <p>Rol: <strong>@Model.RoleName</strong> · Equipo: <strong>@Model.Team</strong></p>
    </div>
    <div class="user-country-card" aria-label="Información del país asignado">
        @if (!string.IsNullOrWhiteSpace(userFlagUrl))
        {
            <img class="user-country-flag" src="@userFlagUrl" alt="Bandera de @Model.CountryName" />
        }
        else
        {
            <div class="user-country-flag user-country-flag-empty" aria-hidden="true">?</div>
        }
        <div>
            <span>País asignado</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.CountryName) ? "Sin país" : Model.CountryName)</strong>
        </div>
    </div>
</div>

<div class="dashboard-grid dashboard-grid-four">
    <div class="stat-card stat-card-accent">
        <span>Puntos</span>
        <strong>@Model.PlayerPoints.ToString("0")</strong>
        <p>Puntaje actual del jugador.</p>
    </div>
    <div class="stat-card">
        <span>Partidos</span>
        <strong>@Model.PlayerMatches.ToString("0")</strong>
        <p>Partidos registrados.</p>
    </div>
    <div class="stat-card">
        <span>Goles a favor</span>
        <strong>@Model.GoalsFor.ToString("0")</strong>
        <p>Calculados según resultados.</p>
    </div>
    <div class="stat-card">
        <span>Goles en contra</span>
        <strong>@Model.GoalsAgainst.ToString("0")</strong>
        <p>Diferencia: @Model.PlayerGoalDifference.ToString("+0;-0;0")</p>
    </div>
</div>

<div class="analytics-grid">
    <section class="analytics-card">
        <div class="section-title compact-title">
            <div>
                <span class="eyebrow">Tabla</span>
                <h2>Tabla de posiciones</h2>
            </div>
        </div>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Pos.</th>
                        <th>Jugador</th>
                        <th>País</th>
                        @* <th>Equipo</th> *@
                        <th>PJ</th>
                        <th>GF</th>
                        <th>GC</th>
                        <th>DG</th>
                        <th>Pts</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Standings.Count == 0)
                    {
                        <tr><td colspan="10" class="empty-row">Aún no hay competidores registrados.</td></tr>
                    }
                    else
                    {
                        foreach (var row in Model.Standings)
                        {
                            var rowFlagUrl = string.IsNullOrWhiteSpace(row.CountryFlagFileName)
                                ? string.Empty
                                : Url.Content($"~/img/banderas/{System.Uri.EscapeDataString(row.CountryCode)}.png");
                            var rowCountryLabel = string.IsNullOrWhiteSpace(row.CountryName) ? row.Team : row.CountryName;

                            <tr class="@(row.IsCurrentUser ? "current-player-row" : string.Empty)">
                                <td class="text-strong">@(row.Position == 0 ? "--" : row.Position.ToString("0"))</td>
                                <td>@row.Name</td>
                                <td>
                                    <span class="table-country-flag-cell table-country-flag-cell-with-name">
                                        @if (!string.IsNullOrWhiteSpace(rowFlagUrl))
                                        {
                                            <img class="table-country-flag" src="@rowFlagUrl" alt="Bandera de @rowCountryLabel" />
                                        }
                                        else
                                        {
                                            <span class="table-country-flag-placeholder" aria-hidden="true">--</span>
                                        }
                                        <span>@rowCountryLabel</span>
                                    </span>
                                </td>
                                @* <td>@row.Team</td> *@
                                <td>@row.Matches.ToString("0")</td>
                                <td>@row.GoalsFor.ToString("0")</td>
                                <td>@row.GoalsAgainst.ToString("0")</td>
                                <td>@row.GoalDifference.ToString("+0;-0;0")</td>
                                <td class="text-strong">@row.Points.ToString("0")</td>
                                <td>@(string.IsNullOrWhiteSpace(row.Status) ? "Activo" : row.Status)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="analytics-card today-matches-card">
        <div class="section-title compact-title">
            <div>
                <span class="eyebrow">Calendario</span>
                <h2>Partidos de hoy</h2>
            </div>
        </div>
        @if (Model.TodayMatches.Count == 0)
        {
            <div class="dashboard-empty-state">No hay partidos programados para hoy.</div>
        }
        else
        {
            <div class="today-match-list">
                @foreach (var match in Model.TodayMatches)
                {
                    var player1PhotoUrl = Url.Content($"~/img/users/{System.Uri.EscapeDataString(match.Player1.PlayerId)}.png");
                    var player2PhotoUrl = Url.Content($"~/img/users/{System.Uri.EscapeDataString(match.Player2.PlayerId)}.png");
                    var player1FlagUrl = string.IsNullOrWhiteSpace(match.Player1.CountryFlagFileName)
                        ? string.Empty
                        : Url.Content($"~/img/banderas/{System.Uri.EscapeDataString(match.Player1.CountryCode)}.png");
                    var player2FlagUrl = string.IsNullOrWhiteSpace(match.Player2.CountryFlagFileName)
                        ? string.Empty
                        : Url.Content($"~/img/banderas/{System.Uri.EscapeDataString(match.Player2.CountryCode)}.png");
                    var player1CountryLabel = string.IsNullOrWhiteSpace(match.Player1.CountryName) ? match.Player1.Team : match.Player1.CountryName;
                    var player2CountryLabel = string.IsNullOrWhiteSpace(match.Player2.CountryName) ? match.Player2.Team : match.Player2.CountryName;

                    <article class="today-match-card">
                        <div class="today-match-meta">
                            <strong>@match.TimeLabel</strong>
                            <span>@(string.IsNullOrWhiteSpace(match.Name) ? match.Code : match.Name)</span>
                        </div>
                        <div class="today-match-lineup">
                            <div class="today-match-player">
                                <div class="today-match-media">
                                    <img class="today-match-user-photo" src="@player1PhotoUrl" alt="Foto de @match.Player1.Name" asp-append-version="true" />
                                    @if (!string.IsNullOrWhiteSpace(player1FlagUrl))
                                    {
                                        <img class="today-match-flag" src="@player1FlagUrl" alt="Bandera de @player1CountryLabel" />
                                    }
                                </div>
                                <strong>@match.Player1.Name</strong>
                                <span>@player1CountryLabel</span>
                            </div>
                            <div class="today-match-score" aria-label="Marcador @match.ScoreLabel">@match.ScoreLabel</div>
                            <div class="today-match-player today-match-player-right">
                                <div class="today-match-media">
                                    <img class="today-match-user-photo" src="@player2PhotoUrl" alt="Foto de @match.Player2.Name" asp-append-version="true" />
                                    @if (!string.IsNullOrWhiteSpace(player2FlagUrl))
                                    {
                                        <img class="today-match-flag" src="@player2FlagUrl" alt="Bandera de @player2CountryLabel" />
                                    }
                                </div>
                                <strong>@match.Player2.Name</strong>
                                <span>@player2CountryLabel</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

<div class="analytics-grid dashboard-lower-analytics">
    <div class="dashboard-lower-spacer" aria-hidden="true"></div>
    <section class="analytics-card goals-card">
        <div class="section-title compact-title">
            <div>
                <span class="eyebrow">Ataque</span>
                <h2>Goles a favor</h2>
            </div>
        </div>
        @if (Model.GoalChart.Count == 0)
        {
            <div class="dashboard-empty-state">No hay resultados para graficar.</div>
        }
        else
        {
            <div class="status-list">
                @foreach (var row in Model.GoalChart)
                {
                    <div class="status-row">
                        <div class="status-row-header">
                            <strong>@row.Team</strong>
                            <span>@row.GoalsFor.ToString("0") goles</span>
                        </div>
                        <div class="progress-track" aria-hidden="true">
                            <span style="width: @row.Percentage%"></span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    @if (showAssignmentPopup)
    {
        <script>
            (() => {
                const modal = document.getElementById('countryAssignmentModal');
                if (!modal) {
                    return;
                }

                const closeModal = () => modal.remove();
                modal.querySelectorAll('[data-close-country-modal]').forEach(button => {
                    button.addEventListener('click', closeModal);
                });
                modal.addEventListener('click', event => {
                    if (event.target === modal) {
                        closeModal();
                    }
                });
            })();
        </script>
    }
}
