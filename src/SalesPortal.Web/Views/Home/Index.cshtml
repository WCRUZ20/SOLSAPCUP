<div class="section-title dashboard-table-title">
    <div>
        <span class="eyebrow">Actividad</span>
        <h2>Últimos pedidos</h2>
    </div>
    <a class="btn btn-outline" asp-controller="Orders" asp-action="Index">Ver listado completo</a>
</div>

<div class="table-wrapper dashboard-orders-grid">
    <table>
        <thead>
            <tr>
                <th>#Num pedido</th>
                <th>Fecha pedido</th>
                <th>Estado</th>
                <th>Total</th>
                <th>Dirección envío</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.RecentOrders.Count == 0)
            {
                <tr>
                    <td colspan="6" class="empty-row">Sin pedidos recientes por el momento.</td>
                </tr>
            }
            else
            {
                foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td class="text-strong">@order.DocNum</td>
                        <td>@order.DocDate.ToString("dd/MM/yyyy")</td>
                        <td>@(string.IsNullOrWhiteSpace(order.Status) ? "Sin estado" : order.Status)</td>
                        <td>@order.DocTotal.ToString("C")</td>
                        <td>@(string.IsNullOrWhiteSpace(order.ShippingAddress) ? "Sin dirección" : order.ShippingAddress)</td>
                        <td>
                            <a class="btn btn-outline" asp-controller="Orders" asp-action="Preview" asp-route-docEntry="@order.DocEntry">Ver orden</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div> *@
