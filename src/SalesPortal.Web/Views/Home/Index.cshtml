@model SalesPortal.Web.Models.Home.DashboardViewModel

@{
    ViewData["Title"] = "Inicio";
    var maxMonthlyValue = Model.MonthlySales.Count == 0 ? 0 : Model.MonthlySales.Max(month => month.Amount);
}

<div class="dashboard-hero">
    <div>
        <span class="eyebrow">Resumen competicion</span>
        <h2>Hola, @User.Identity?.Name</h2>
        @* <p>Consulta rápidamente tus pedidos recientes, el comportamiento de compra y las oportunidades para crear nuevas órdenes.</p> *@
    </div>
    <div class="dashboard-actions">
        @* <a class="btn btn-light" asp-controller="Orders" asp-action="Index">Ver pedidos</a>
        <a class="btn btn-primary" asp-controller="Orders" asp-action="Create">Nuevo pedido</a> *@
    </div>
</div>

@* <div class="dashboard-grid dashboard-grid-four">
    <div class="stat-card stat-card-accent">
        <span>Pedidos últimos 30 días</span>
        <strong>@Model.OrdersLast30Days</strong>
        <p>@Model.TotalAmountLast30Days.ToString("C") facturados en el periodo</p>
    </div>

    <div class="stat-card">
        <span>Promedio Pedido</span>
        <strong>@Model.AverageTicketLast30Days.ToString("C")</strong>
        <p>Promedio por pedido de los últimos 30 días</p>
    </div>

    <div class="stat-card">
        <span>Productos disponibles</span>
        <strong>@Model.AvailableProducts</strong>
        <p>Artículos activos para crear pedidos</p>
    </div>

    <div class="stat-card">
        <span>Último pedido</span>
        <strong>@(Model.LastOrderDate?.ToString("dd/MM") ?? "--")</strong>
        <p>@Model.TotalOrders pedidos consultados en 6 meses</p>
    </div>
</div> *@

