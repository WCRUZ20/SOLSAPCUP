@using SalesPortal.Shared.Security
@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SOLSAP CUP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="shortcut icon" href="~/img/solsapcuplogosf.ico" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="SOLSAP CUP - Inicio">
                <img class="brand-logo-sb" src="~/img/solsapcuplogosf.png" alt="SOLSAP CUP" asp-append-version="true" />
            </a>

            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            }

            <nav class="menu" aria-label="Navegación principal">
                <a class="menu-item @(currentController == "Home" ? "active" : string.Empty)" asp-controller="Home" asp-action="Index">Inicio</a>
                <a class="menu-item @(currentController == "Matches" ? "active" : string.Empty)" asp-controller="Matches" asp-action="Index">Mis partidos</a>
                @if (User.IsInRole("Admin"))
                {
                    var isAdminCupActive = currentController == "AdminCup";
                    <div class="menu-module has-submenu @(isAdminCupActive ? "is-expanded" : string.Empty)" data-sidebar-module>
                        <button class="menu-item menu-module-toggle @(isAdminCupActive ? "active" : string.Empty)"
                                type="button"
                                aria-expanded="@(isAdminCupActive.ToString().ToLowerInvariant())"
                                data-sidebar-module-toggle>
                            <span>Administración</span>
                            <span class="menu-caret" aria-hidden="true"></span>
                        </button>
                        <div class="submenu @(isAdminCupActive ? string.Empty : "is-collapsed")" aria-label="Submódulos de administración" aria-hidden="@((!isAdminCupActive).ToString().ToLowerInvariant())" data-sidebar-submenu>
                            <div class="submenu-panel">
                                <a class="submenu-item @(isAdminCupActive && currentAction == "Players" ? "active" : string.Empty)" asp-controller="AdminCup" asp-action="Players" tabindex="@(isAdminCupActive ? null : "-1")">Jugadores</a>
                                <a class="submenu-item @(isAdminCupActive && currentAction == "Matches" ? "active" : string.Empty)" asp-controller="AdminCup" asp-action="Matches" tabindex="@(isAdminCupActive ? null : "-1")">Partidos</a>
                                <a class="submenu-item @(isAdminCupActive && currentAction == "Countries" ? "active" : string.Empty)" asp-controller="AdminCup" asp-action="Countries" tabindex="@(isAdminCupActive ? null : "-1")">Países</a>
                            </div>
                        </div>
                    </div>
                }
            </nav>

            @{
                var userWeb = User.FindFirstValue(PortalClaimTypes.UserWeb) ?? User.Identity?.Name ?? string.Empty;
                var userPhotoUrl = Url.Content($"~/img/users/{Uri.EscapeDataString(userWeb)}.png");
            }

            <div class="sidebar-session">
                <div class="sidebar-user" aria-label="Usuario conectado">
                    <img class="sidebar-user-photo" src="@userPhotoUrl" alt="Foto de perfil de @userWeb" asp-append-version="true" />
                    <span class="sidebar-user-code">@userWeb</span>
                </div>

                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-red sidebar-logout">Cerrar sesión</button>
                </form>
            </div>
        </aside>

        <main class="main-content">
            @* <header class="topbar">
                <div>
                    <h1>@ViewData["Title"]</h1>
                </div>
            </header> *@

            @if (TempData["Success"] != null)
            {
                <div class="alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert-danger">@TempData["Error"]</div>
            }

            <section class="content-card">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>