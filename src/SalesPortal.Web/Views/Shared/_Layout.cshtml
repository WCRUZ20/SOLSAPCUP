<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SOLSAP CUP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="shortcut icon" href="~/img/solsapcuplogosf.ico" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="SOLSAP CUP - Inicio">
                <img class="brand-logo-sb" src="~/img/solsapcuplogosf.png" alt="SOLSAP CUP" asp-append-version="true" />
            </a>

            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            }

            <nav class="menu" aria-label="Navegación principal">
                <a class="menu-item @(currentController == "Home" ? "active" : string.Empty)" asp-controller="Home" asp-action="Index">Inicio</a>
                <a class="menu-item @(currentController == "Matches" ? "active" : string.Empty)" asp-controller="Matches" asp-action="Index">Mis partidos</a>
                @if (User.IsInRole("Admin"))
                {
                    <div class="menu-module">
                        <a class="menu-item @(currentController == "AdminCup" ? "active" : string.Empty)" asp-controller="AdminCup" asp-action="Index">Administración</a>
                        <div class="submenu" aria-label="Submódulos de administración">
                            <a class="submenu-item @(currentController == "AdminCup" && currentAction == "Players" ? "active" : string.Empty)" asp-controller="AdminCup" asp-action="Players">Jugadores</a>
                            <a class="submenu-item @(currentController == "AdminCup" && currentAction == "Matches" ? "active" : string.Empty)" asp-controller="AdminCup" asp-action="Matches">Partidos</a>
                        </div>
                    </div>
                }
            </nav>

            <div class="sidebar-session">
                <p>Bienvenido, @User.Identity?.Name</p>

                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-red sidebar-logout">Cerrar sesión</button>
                </form>
            </div>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div>
                    <h1>@ViewData["Title"]</h1>
                </div>
            </header>

            @if (TempData["Success"] != null)
            {
                <div class="alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert-danger">@TempData["Error"]</div>
            }

            <section class="content-card">
                @RenderBody()
            </section>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>