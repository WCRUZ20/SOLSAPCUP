@{
    ViewData["Title"] = "Administración Copa";
}

<div class="admin-module-header">
    <div>
        <span class="eyebrow">Administración</span>
        <h2>Selecciona un submódulo</h2>
        <p>Gestiona por separado el registro de jugadores, partidos y países del mundial.</p>
    </div>
</div>

<div class="admin-cup-grid">
    <section class="cup-card admin-module-card">
        <div class="cup-card-header">
            <div>
                <span class="eyebrow">Jugadores</span>
                <h3>Registro de jugadores</h3>
            </div>
        </div>
        <p>Crear y actualizar jugadores, equipos, puntos y posición en tabla.</p>
        <a class="btn btn-primary" asp-action="Players">Administrar jugadores</a>
    </section>

    <section class="cup-card admin-module-card">
        <div class="cup-card-header">
            <div>
                <span class="eyebrow">Partidos</span>
                <h3>Registro de partidos</h3>
            </div>
        </div>
        <p>Crear y actualizar programación, participantes, resultados y observaciones.</p>
        <a class="btn btn-primary" asp-action="Matches">Administrar partidos</a>
    </section>

    <section class="cup-card admin-module-card">
        <div class="cup-card-header">
            <div>
                <span class="eyebrow">Países</span>
                <h3>Registro de países</h3>
            </div>
        </div>
        <p>Crear y actualizar códigos y nombres de los países participantes del mundial.</p>
        <a class="btn btn-primary" asp-action="Countries">Administrar países</a>
    </section>
</div>
