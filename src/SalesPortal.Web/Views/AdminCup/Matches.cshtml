@model SalesPortal.Web.Models.Cup.AdminCupMatchesViewModel
@{
    ViewData["Title"] = "Administración - Partidos";
}

@* <div class="admin-compact-header">
    <div>
        <span class="eyebrow">Administración de copa</span>
        <h2>Partidos</h2>
        <p>Agrega, modifica o elimina partidos manteniendo la tabla visible.</p>
    </div>  
</div> *@

<section class="admin-workspace" data-admin-editor-scope>
    <div class="cup-card admin-list-panel">
        <div class="admin-panel-heading">
            <div style="width: 70%;">
                <span class="eyebrow">Paso 1</span>
                <h3>Buscar y seleccionar</h3>
            </div>
            <div class="admin-module-actions">
                <form asp-action="CalculateMatches" method="post" class="admin-inline-action" onsubmit="return confirm('¿Calcular el calendario con todos los jugadores activos?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Calcular partidos</button>
                </form>
            </div>
            <div><span class="admin-record-count" data-admin-grid-count>@Model.Matches.Count registros</span></div>            
        </div>
        <div class="admin-table-toolbar admin-table-toolbar-compact">
            <label class="admin-search-field">
                <span>Buscar partido</span>
                <input type="search" placeholder="Código, fecha, jugador, resultado u observación" data-admin-grid-search />
            </label>
        </div>
        <div class="table-wrapper admin-table admin-table-compact" data-admin-editor-grid>
            <table>
                <thead><tr><th>Código</th><th>Nombre</th><th>Fecha</th><th>Hora</th><th>J1</th><th>J2</th><th>Resultado</th><th>Observación</th></tr></thead>
                <tbody>
                @foreach (var match in Model.Matches)
                {
                    <tr class="admin-selectable-row" tabindex="0" data-summary-title="@match.Name" data-summary-detail="@match.Player1 vs @match.Player2" data-field-code="@match.Code" data-field-name="@match.Name" data-field-match-date="@(match.MatchDate?.ToString("yyyy-MM-dd") ?? string.Empty)" data-field-match-time="@(match.MatchTime?.ToString("0000") ?? string.Empty)" data-field-player1="@match.Player1" data-field-player2="@match.Player2" data-field-goals-player1="@(match.GoalsPlayer1?.ToString("0") ?? string.Empty)" data-field-goals-player2="@(match.GoalsPlayer2?.ToString("0") ?? string.Empty)" data-field-observation="@match.Observation"><td class="text-strong">@match.Code</td><td>@match.Name</td><td>@(match.MatchDate?.ToString("dd/MM/yyyy") ?? "--")</td><td>@(match.MatchTime?.ToString("0000") ?? "--")</td><td>@match.Player1</td><td>@match.Player2</td><td><span class="admin-table-chip">@(match.GoalsPlayer1.HasValue || match.GoalsPlayer2.HasValue ? $"{match.GoalsPlayer1?.ToString("0") ?? "-"} - {match.GoalsPlayer2?.ToString("0") ?? "-"}" : "Pendiente")</span></td><td>@match.Observation</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <aside class="cup-card admin-module-card admin-editor-card admin-editor-panel" aria-labelledby="match-editor-title">
        <div class="admin-panel-heading admin-editor-heading">
            <div>
                <span class="eyebrow">Paso 2</span>
                <h3 id="match-editor-title">Agregar / editar partido</h3>
            </div>
            <span class="admin-status-pill" data-admin-editor-status>Sin selección</span>
        </div>
        <div class="admin-selected-summary admin-selected-summary-compact" data-admin-selected-summary aria-live="polite">
            <span>Partido</span>
            <strong>Ningún registro seleccionado</strong>
        </div>
        <p class="admin-selection-help" data-admin-editor-help>Selecciona una fila o crea un partido nuevo.</p>
        <form asp-action="SaveMatch" method="post" class="cup-form admin-compact-form" data-admin-editor-form>
            @Html.AntiForgeryToken()
            <div class="form-field is-readonly">
                <label asp-for="Match.Code">Código</label>
                <input asp-for="Match.Code" class="cup-input" placeholder="Código" disabled data-admin-field="code" data-locked="true" />
            </div>
            <div class="form-field is-readonly">
                <label asp-for="Match.Name">Nombre</label>
                <input asp-for="Match.Name" class="cup-input" placeholder="Nombre" disabled data-admin-field="name" data-locked="true" />
            </div>
            <div class="form-field is-readonly">
                <label asp-for="Match.MatchDate">Fecha</label>
                <input asp-for="Match.MatchDate" type="date" class="cup-input" disabled data-admin-field="matchDate" data-locked="true" />
            </div>
            <div class="form-field is-readonly">
                <label asp-for="Match.MatchTime">Hora</label>
                <input asp-for="Match.MatchTime" class="cup-input" placeholder="HHMM" disabled data-admin-field="matchTime" data-locked="true" />
            </div>
            <div class="form-field is-readonly">
                <label asp-for="Match.Player1">Jugador 1</label>
                <input asp-for="Match.Player1" class="cup-input" placeholder="Jugador 1" disabled data-admin-field="player1" data-locked="true" />
            </div>
            <div class="form-field is-readonly">
                <label asp-for="Match.Player2">Jugador 2</label>
                <input asp-for="Match.Player2" class="cup-input" placeholder="Jugador 2" disabled data-admin-field="player2" data-locked="true" />
            </div>
            <div class="form-field score-field match-goals-field">
                <label asp-for="Match.GoalsPlayer1">Goles J1</label>
                <input asp-for="Match.GoalsPlayer1" class="cup-input" type="number" step="1" min="0" placeholder="0" disabled data-admin-field="goalsPlayer1" />
            </div>
            <div class="form-field score-field match-goals-field">
                <label asp-for="Match.GoalsPlayer2">Goles J2</label>
                <input asp-for="Match.GoalsPlayer2" class="cup-input" type="number" step="1" min="0" placeholder="0" disabled data-admin-field="goalsPlayer2" />
            </div>
            <div class="form-field form-field-wide">
                <label asp-for="Match.Observation">Observación</label>
                <textarea asp-for="Match.Observation" class="cup-input cup-comments-input" placeholder="Nota breve" disabled data-admin-field="observation"></textarea>
            </div>
            <div class="admin-form-actions">
                <button type="button" class="btn btn-light" data-admin-editor-new>Nuevo</button>
                <button type="button" class="btn btn-light" data-admin-editor-clear disabled>Limpiar</button>
                <button type="submit" class="btn btn-primary" disabled data-admin-editor-submit>Guardar</button>
            </div>
        </form>
        <form asp-action="DeleteMatch" method="post" class="admin-delete-form" data-admin-delete-form onsubmit="return confirm('¿Eliminar este partido?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="code" data-admin-delete-key />
            <button type="submit" class="btn btn-red" data-admin-delete-submit disabled>Eliminar partido</button>
        </form>
    </aside>
</section>
