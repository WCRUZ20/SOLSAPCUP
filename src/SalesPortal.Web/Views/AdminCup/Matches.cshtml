@model SalesPortal.Web.Models.Cup.AdminCupMatchesViewModel
@{
    ViewData["Title"] = "Administración - Partidos";
}

<div class="admin-module-header">
    <div>
        <span class="eyebrow">Submódulo de administración</span>
        <h2>Registro de partidos</h2>
        <p>Selecciona un partido del grid para cargar sus datos y actualizar únicamente el resultado y la observación.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Players">Ir a jugadores</a>
    <a class="btn btn-secondary" asp-action="Countries">Ir a países</a>
</div>

<section class="cup-card admin-module-card">
    <div class="cup-card-header">
        <div>
            <span class="eyebrow">Partidos</span>
            <h3>Actualizar partido seleccionado</h3>
            <p class="admin-selection-help" data-admin-editor-help>Selecciona una fila del grid para habilitar la edición.</p>
        </div>
    </div>
    <form asp-action="SaveMatch" method="post" class="cup-form" data-admin-editor-form>
        @Html.AntiForgeryToken()
        <input asp-for="Match.Code" class="cup-input" placeholder="Código" disabled data-admin-field="code" data-locked="true" />
        <input asp-for="Match.Name" class="cup-input" placeholder="Nombre" disabled data-admin-field="name" data-locked="true" />
        <input asp-for="Match.MatchDate" type="date" class="cup-input" disabled data-admin-field="matchDate" data-locked="true" />
        <input asp-for="Match.MatchTime" class="cup-input" placeholder="Hora (HHMM)" disabled data-admin-field="matchTime" data-locked="true" />
        <input asp-for="Match.Player1" class="cup-input" placeholder="Jugador 1" disabled data-admin-field="player1" data-locked="true" />
        <input asp-for="Match.Player2" class="cup-input" placeholder="Jugador 2" disabled data-admin-field="player2" data-locked="true" />
        <input asp-for="Match.GoalsPlayer1" class="cup-input" placeholder="Goles J1" disabled data-admin-field="goalsPlayer1" />
        <input asp-for="Match.GoalsPlayer2" class="cup-input" placeholder="Goles J2" disabled data-admin-field="goalsPlayer2" />
        <textarea asp-for="Match.Observation" class="cup-input cup-comments-input" placeholder="Observación" disabled data-admin-field="observation"></textarea>
        <button type="submit" class="btn btn-primary" disabled data-admin-editor-submit>Guardar partido</button>
    </form>
</section>

<div class="section-title dashboard-table-title">
    <div>
        <span class="eyebrow">Datos actuales</span>
        <h2>Partidos</h2>
    </div>
</div>
<div class="table-wrapper admin-table" data-admin-editor-grid>
    <table>
        <thead><tr><th>Código</th><th>Nombre</th><th>Fecha</th><th>Hora</th><th>J1</th><th>J2</th><th>Resultado</th><th>Observación</th></tr></thead>
        <tbody>
        @foreach (var match in Model.Matches)
        {
            <tr class="admin-selectable-row" tabindex="0" data-field-code="@match.Code" data-field-name="@match.Name" data-field-match-date="@(match.MatchDate?.ToString("yyyy-MM-dd") ?? string.Empty)" data-field-match-time="@(match.MatchTime?.ToString("0000") ?? string.Empty)" data-field-player1="@match.Player1" data-field-player2="@match.Player2" data-field-goals-player1="@(match.GoalsPlayer1?.ToString("0") ?? string.Empty)" data-field-goals-player2="@(match.GoalsPlayer2?.ToString("0") ?? string.Empty)" data-field-observation="@match.Observation"><td class="text-strong">@match.Code</td><td>@match.Name</td><td>@(match.MatchDate?.ToString("dd/MM/yyyy") ?? "--")</td><td>@(match.MatchTime?.ToString("0000") ?? "--")</td><td>@match.Player1</td><td>@match.Player2</td><td>@(match.GoalsPlayer1.HasValue || match.GoalsPlayer2.HasValue ? $"{match.GoalsPlayer1?.ToString("0") ?? "-"} - {match.GoalsPlayer2?.ToString("0") ?? "-"}" : "Pendiente")</td><td>@match.Observation</td></tr>
        }
        </tbody>
    </table>
</div>
