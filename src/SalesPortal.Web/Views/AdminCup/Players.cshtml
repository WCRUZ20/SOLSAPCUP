@model SalesPortal.Web.Models.Cup.AdminCupPlayersViewModel
@{
    ViewData["Title"] = "Administración - Jugadores";
}

<div class="admin-module-header">
    <div>
        <span class="eyebrow">Submódulo de administración</span>
        <h2>Registro de jugadores</h2>
        <p>Selecciona un jugador del grid para cargar sus datos y actualizar únicamente los campos editables.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Matches">Ir a partidos</a>
    <a class="btn btn-secondary" asp-action="Countries">Ir a países</a>
</div>

<section class="cup-card admin-module-card">
    <div class="cup-card-header">
        <div>
            <span class="eyebrow">Jugadores</span>
            <h3>Actualizar jugador seleccionado</h3>
            <p class="admin-selection-help" data-admin-editor-help>Selecciona una fila del grid para habilitar la edición.</p>
        </div>
    </div>
    <form asp-action="SaveCompetitor" method="post" class="cup-form" data-admin-editor-form>
        @Html.AntiForgeryToken()
        <input asp-for="Competitor.Code" class="cup-input" placeholder="Código" disabled data-admin-field="code" data-locked="true" />
        <input asp-for="Competitor.Name" class="cup-input" placeholder="Nombre" disabled data-admin-field="name" data-locked="true" />
        <input asp-for="Competitor.PlayerId" class="cup-input" placeholder="ID jugador / CardCode" disabled data-admin-field="playerId" data-locked="true" />
        <input asp-for="Competitor.Team" class="cup-input" placeholder="Equipo" disabled data-admin-field="team" data-locked="true" />
        <input asp-for="Competitor.Matches" class="cup-input" placeholder="Partidos" disabled data-admin-field="matches" />
        <input asp-for="Competitor.Points" class="cup-input" placeholder="Puntos" disabled data-admin-field="points" />
        <input asp-for="Competitor.GoalDifference" class="cup-input" placeholder="Diferencia goles" disabled data-admin-field="goalDifference" />
        <input asp-for="Competitor.TablePosition" class="cup-input" placeholder="Posición" disabled data-admin-field="tablePosition" />
        <input asp-for="Competitor.Status" class="cup-input" placeholder="Estado" disabled data-admin-field="status" />
        <button type="submit" class="btn btn-primary" disabled data-admin-editor-submit>Guardar jugador</button>
    </form>
</section>

<div class="section-title dashboard-table-title">
    <div>
        <span class="eyebrow">Datos actuales</span>
        <h2>Jugadores</h2>
    </div>
</div>
<div class="table-wrapper admin-table" data-admin-editor-grid>
    <table>
        <thead><tr><th>Código</th><th>Nombre</th><th>ID jugador</th><th>Equipo</th><th>PJ</th><th>Pts</th><th>DG</th><th>Pos.</th><th>Estado</th></tr></thead>
        <tbody>
        @foreach (var competitor in Model.Competitors)
        {
            <tr class="admin-selectable-row" tabindex="0" data-field-code="@competitor.Code" data-field-name="@competitor.Name" data-field-player-id="@competitor.PlayerId" data-field-team="@competitor.Team" data-field-matches="@competitor.Matches.ToString("0")" data-field-points="@competitor.Points.ToString("0")" data-field-goal-difference="@competitor.GoalDifference.ToString("0")" data-field-table-position="@competitor.TablePosition.ToString("0")" data-field-status="@competitor.Status"><td class="text-strong">@competitor.Code</td><td>@competitor.Name</td><td>@competitor.PlayerId</td><td>@competitor.Team</td><td>@competitor.Matches.ToString("0")</td><td>@competitor.Points.ToString("0")</td><td>@competitor.GoalDifference.ToString("+0;-0;0")</td><td>@competitor.TablePosition.ToString("0")</td><td>@competitor.Status</td></tr>
        }
        </tbody>
    </table>
</div>
