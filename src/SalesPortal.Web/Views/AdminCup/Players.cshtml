@model SalesPortal.Web.Models.Cup.AdminCupPlayersViewModel
@{
    ViewData["Title"] = "Administración - Jugadores";
    var assignableCountries = Model.Countries
        .Where(country => !string.IsNullOrWhiteSpace(country.CountryCode) && !string.IsNullOrWhiteSpace(country.CountryName))
        .ToList();
    var countriesJson = System.Text.Json.JsonSerializer.Serialize(assignableCountries.Select(country => new
    {
        code = country.CountryCode,
        name = country.CountryName
    }));
}

<div class="admin-module-header">
    <div>
        <span class="eyebrow">Submódulo de administración</span>
        <h2>Registro de jugadores</h2>
        <p>Administra los jugadores participantes, sus equipos y datos de tabla.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Matches">Ir a partidos</a>
    <a class="btn btn-secondary" asp-action="Countries">Ir a países</a>
</div>

<section class="cup-card admin-module-card">
    <div class="cup-card-header">
        <div>
            <span class="eyebrow">Jugadores</span>
            <h3>Registrar / actualizar jugador</h3>
        </div>
    </div>
    <form asp-action="SaveCompetitor" method="post" class="cup-form">
        @Html.AntiForgeryToken()
        <input asp-for="Competitor.Code" class="cup-input" placeholder="Código" />
        <input asp-for="Competitor.Name" class="cup-input" placeholder="Nombre" />
        <input asp-for="Competitor.PlayerId" class="cup-input" placeholder="ID jugador / CardCode" />
        <div class="team-assignment-field">
            <input asp-for="Competitor.Team" class="cup-input" placeholder="País / equipo asignado" />
            <button type="button" class="btn btn-outline" id="assignRandomCountryButton" disabled="@(assignableCountries.Count == 0)">Asignar país aleatorio</button>
        </div>
        <input asp-for="Competitor.Matches" class="cup-input" placeholder="Partidos" />
        <input asp-for="Competitor.Points" class="cup-input" placeholder="Puntos" />
        <input asp-for="Competitor.GoalDifference" class="cup-input" placeholder="Diferencia goles" />
        <input asp-for="Competitor.TablePosition" class="cup-input" placeholder="Posición" />
        <input asp-for="Competitor.Status" class="cup-input" placeholder="Estado" />
        <button type="submit" class="btn btn-primary">Guardar jugador</button>
    </form>
</section>

<div class="section-title dashboard-table-title">
    <div>
        <span class="eyebrow">Datos actuales</span>
        <h2>Jugadores</h2>
    </div>
</div>
<div class="table-wrapper admin-table">
    <table>
        <thead><tr><th>Código</th><th>Nombre</th><th>ID jugador</th><th>País / equipo</th><th>PJ</th><th>Pts</th><th>DG</th><th>Pos.</th><th>Estado</th></tr></thead>
        <tbody>
        @foreach (var competitor in Model.Competitors)
        {
            <tr><td class="text-strong">@competitor.Code</td><td>@competitor.Name</td><td>@competitor.PlayerId</td><td>@competitor.Team</td><td>@competitor.Matches.ToString("0")</td><td>@competitor.Points.ToString("0")</td><td>@competitor.GoalDifference.ToString("+0;-0;0")</td><td>@competitor.TablePosition.ToString("0")</td><td>@competitor.Status</td></tr>
        }
        </tbody>
    </table>
</div>

<div class="modal-overlay" id="countryAssignmentModal" role="dialog" aria-modal="true" aria-labelledby="countryAssignmentTitle" hidden>
    <div class="modal-card country-assignment-modal">
        <button type="button" class="modal-close" id="closeCountryAssignmentModal" aria-label="Cerrar">×</button>
        <span class="eyebrow">Asignación aleatoria</span>
        <h2 id="countryAssignmentTitle">Su país asignado aleatoriamente es</h2>
        <img id="assignedCountryFlag" class="country-flag country-flag-modal" alt="" />
        <strong id="assignedCountryName"></strong>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const countries = @Html.Raw(countriesJson);
            const assignButton = document.getElementById('assignRandomCountryButton');
            const teamInput = document.getElementById('Competitor_Team');
            const modal = document.getElementById('countryAssignmentModal');
            const closeButton = document.getElementById('closeCountryAssignmentModal');
            const countryName = document.getElementById('assignedCountryName');
            const countryFlag = document.getElementById('assignedCountryFlag');

            const closeModal = () => {
                modal.hidden = true;
            };

            assignButton?.addEventListener('click', () => {
                if (countries.length === 0) {
                    return;
                }

                const assignedCountry = countries[Math.floor(Math.random() * countries.length)];
                teamInput.value = assignedCountry.name;
                countryName.textContent = assignedCountry.name;
                countryFlag.src = `/imgs/banderas/${assignedCountry.code}.png`;
                countryFlag.alt = `Bandera de ${assignedCountry.name}`;
                modal.hidden = false;
            });

            closeButton?.addEventListener('click', closeModal);
            modal?.addEventListener('click', event => {
                if (event.target === modal) {
                    closeModal();
                }
            });
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape' && !modal.hidden) {
                    closeModal();
                }
            });
        })();
    </script>
}
