@model SalesPortal.Web.Models.Cup.AdminCupPlayersViewModel
@{
    ViewData["Title"] = "Administración - Jugadores";
}

<div class="admin-compact-header">
    <div>
        <span class="eyebrow">Administración de copa</span>
        <h2>Jugadores</h2>
        <p>Agrega, modifica o elimina jugadores desde la tabla y el editor lateral.</p>
    </div>
    <div class="admin-module-actions">
        <a class="btn btn-secondary" asp-action="Matches">Partidos</a>
        <a class="btn btn-secondary" asp-action="Countries">Países</a>
    </div>
</div>

<section class="admin-workspace" data-admin-editor-scope>
    <div class="cup-card admin-list-panel">
        <div class="admin-panel-heading">
            <div>
                <span class="eyebrow">Paso 1</span>
                <h3>Buscar y seleccionar</h3>
            </div>
            <span class="admin-record-count" data-admin-grid-count>@Model.Competitors.Count registros</span>
        </div>
        <div class="admin-table-toolbar admin-table-toolbar-compact">
            <label class="admin-search-field">
                <span>Buscar jugador</span>
                <input type="search" placeholder="Código, nombre, ID, equipo o estado" data-admin-grid-search />
            </label>
        </div>
        <div class="table-wrapper admin-table admin-table-compact" data-admin-editor-grid>
            <table>
                <thead><tr><th>Código</th><th>Nombre</th><th>ID jugador</th><th>Equipo</th><th>PJ</th><th>Pts</th><th>DG</th><th>Pos.</th><th>Estado</th></tr></thead>
                <tbody>
                @foreach (var competitor in Model.Competitors)
                {
                    <tr class="admin-selectable-row" tabindex="0" data-summary-title="@competitor.Name" data-summary-detail="@competitor.Code · @competitor.Team" data-field-code="@competitor.Code" data-field-name="@competitor.Name" data-field-player-id="@competitor.PlayerId" data-field-team="@competitor.Team" data-field-matches="@competitor.Matches.ToString("0")" data-field-points="@competitor.Points.ToString("0")" data-field-goal-difference="@competitor.GoalDifference.ToString("0")" data-field-table-position="@competitor.TablePosition.ToString("0")" data-field-status="@competitor.Status"><td class="text-strong">@competitor.Code</td><td>@competitor.Name</td><td>@competitor.PlayerId</td><td>@competitor.Team</td><td>@competitor.Matches.ToString("0")</td><td>@competitor.Points.ToString("0")</td><td>@competitor.GoalDifference.ToString("+0;-0;0")</td><td>@competitor.TablePosition.ToString("0")</td><td><span class="admin-table-chip">@competitor.Status</span></td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <aside class="cup-card admin-module-card admin-editor-card admin-editor-panel" aria-labelledby="player-editor-title">
        <div class="admin-panel-heading admin-editor-heading">
            <div>
                <span class="eyebrow">Paso 2</span>
                <h3 id="player-editor-title">Agregar / editar jugador</h3>
            </div>
            <span class="admin-status-pill" data-admin-editor-status>Sin selección</span>
        </div>
        <div class="admin-selected-summary admin-selected-summary-compact" data-admin-selected-summary aria-live="polite">
            <span>Jugador</span>
            <strong>Ningún registro seleccionado</strong>
        </div>
        <p class="admin-selection-help" data-admin-editor-help>Selecciona una fila o crea un registro nuevo.</p>
        <form asp-action="SaveCompetitor" method="post" class="cup-form admin-compact-form" data-admin-editor-form>
            @Html.AntiForgeryToken()
            <div class="form-field is-readonly">
                <label asp-for="Competitor.Code">Código</label>
                <input asp-for="Competitor.Code" class="cup-input" placeholder="Código" disabled data-admin-field="code" data-locked="true" />
            </div>
            <div class="form-field is-readonly">
                <label asp-for="Competitor.Name">Nombre</label>
                <input asp-for="Competitor.Name" class="cup-input" placeholder="Nombre" disabled data-admin-field="name" data-locked="true" />
            </div>
            <div class="form-field is-readonly">
                <label asp-for="Competitor.PlayerId">ID jugador</label>
                <input asp-for="Competitor.PlayerId" class="cup-input" placeholder="CardCode" disabled data-admin-field="playerId" data-locked="true" />
            </div>
            <div class="form-field is-readonly">
                <label asp-for="Competitor.Team">Equipo</label>
                <input asp-for="Competitor.Team" class="cup-input" placeholder="Equipo" disabled data-admin-field="team" data-locked="true" />
            </div>
            <div class="form-field">
                <label asp-for="Competitor.Matches">PJ</label>
                <input asp-for="Competitor.Matches" class="cup-input" type="number" step="1" min="0" placeholder="0" disabled data-admin-field="matches" />
            </div>
            <div class="form-field">
                <label asp-for="Competitor.Points">Puntos</label>
                <input asp-for="Competitor.Points" class="cup-input" type="number" step="1" min="0" placeholder="0" disabled data-admin-field="points" />
            </div>
            <div class="form-field">
                <label asp-for="Competitor.GoalDifference">DG</label>
                <input asp-for="Competitor.GoalDifference" class="cup-input" type="number" step="1" placeholder="0" disabled data-admin-field="goalDifference" />
            </div>
            <div class="form-field">
                <label asp-for="Competitor.TablePosition">Posición</label>
                <input asp-for="Competitor.TablePosition" class="cup-input" type="number" step="1" min="0" placeholder="0" disabled data-admin-field="tablePosition" />
            </div>
            <div class="form-field form-field-wide">
                <label asp-for="Competitor.Status">Estado</label>
                <input asp-for="Competitor.Status" class="cup-input" placeholder="Activo / clasificado / eliminado" disabled data-admin-field="status" />
            </div>
            <div class="admin-form-actions">
                <button type="button" class="btn btn-light" data-admin-editor-new>Nuevo</button>
                <button type="button" class="btn btn-light" data-admin-editor-clear disabled>Limpiar</button>
                <button type="submit" class="btn btn-primary" disabled data-admin-editor-submit>Guardar</button>
            </div>
        </form>
        <form asp-action="DeleteCompetitor" method="post" class="admin-delete-form" data-admin-delete-form onsubmit="return confirm('¿Eliminar este jugador?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="code" data-admin-delete-key />
            <button type="submit" class="btn btn-red" data-admin-delete-submit disabled>Eliminar jugador</button>
        </form>
    </aside>
</section>
