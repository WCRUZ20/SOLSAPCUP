@using System.Globalization
@model SalesPortal.Web.Models.Cup.AdminCupPlayersViewModel
@{
    ViewData["Title"] = "Administración - Jugadores";
}

<div class="admin-module-header">
    <div>
        <span class="eyebrow">Submódulo de administración</span>
        <h2>Registro de jugadores</h2>
        <p>Administra los jugadores participantes, sus equipos y datos de tabla.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Matches">Ir a partidos</a>
    <a class="btn btn-secondary" asp-action="Countries">Ir a países</a>
</div>

<section class="cup-card admin-module-card">
    <div class="cup-card-header">
        <div>
            <span class="eyebrow">Jugadores</span>
            <h3>Actualizar jugador seleccionado</h3>
            <p>Selecciona una fila del grid para cargar sus datos. Código, nombre, ID jugador y equipo son solo lectura.</p>
        </div>
    </div>
    <form asp-action="SaveCompetitor" method="post" class="cup-form" data-grid-edit-form>
        @Html.AntiForgeryToken()
        <input asp-for="Competitor.Code" class="cup-input" placeholder="Código" data-field="code" data-editable="false" disabled />
        <input asp-for="Competitor.Name" class="cup-input" placeholder="Nombre" data-field="name" data-editable="false" disabled />
        <input asp-for="Competitor.PlayerId" class="cup-input" placeholder="ID jugador / CardCode" data-field="playerId" data-editable="false" disabled />
        <input asp-for="Competitor.Team" class="cup-input" placeholder="Equipo" data-field="team" data-editable="false" disabled />
        <input asp-for="Competitor.Matches" class="cup-input" placeholder="Partidos" data-field="matches" data-editable="true" disabled />
        <input asp-for="Competitor.Points" class="cup-input" placeholder="Puntos" data-field="points" data-editable="true" disabled />
        <input asp-for="Competitor.GoalDifference" class="cup-input" placeholder="Diferencia goles" data-field="goalDifference" data-editable="true" disabled />
        <input asp-for="Competitor.TablePosition" class="cup-input" placeholder="Posición" data-field="tablePosition" data-editable="true" disabled />
        <input asp-for="Competitor.Status" class="cup-input" placeholder="Estado" data-field="status" data-editable="true" disabled />
        <button type="submit" class="btn btn-primary" disabled>Guardar jugador</button>
    </form>
</section>

<div class="section-title dashboard-table-title">
    <div>
        <span class="eyebrow">Datos actuales</span>
        <h2>Jugadores</h2>
    </div>
</div>
<div class="table-wrapper admin-table" data-grid-edit-table>
    <table>
        <thead><tr><th>Código</th><th>Nombre</th><th>ID jugador</th><th>Equipo</th><th>PJ</th><th>Pts</th><th>DG</th><th>Pos.</th><th>Estado</th></tr></thead>
        <tbody>
        @foreach (var competitor in Model.Competitors)
        {
            <tr tabindex="0"
                data-code="@competitor.Code"
                data-name="@competitor.Name"
                data-player-id="@competitor.PlayerId"
                data-team="@competitor.Team"
                data-matches="@competitor.Matches.ToString(CultureInfo.InvariantCulture)"
                data-points="@competitor.Points.ToString(CultureInfo.InvariantCulture)"
                data-goal-difference="@competitor.GoalDifference.ToString(CultureInfo.InvariantCulture)"
                data-table-position="@competitor.TablePosition.ToString(CultureInfo.InvariantCulture)"
                data-status="@competitor.Status">
                <td class="text-strong">@competitor.Code</td>
                <td>@competitor.Name</td>
                <td>@competitor.PlayerId</td>
                <td>@competitor.Team</td>
                <td>@competitor.Matches.ToString("0")</td>
                <td>@competitor.Points.ToString("0")</td>
                <td>@competitor.GoalDifference.ToString("+0;-0;0")</td>
                <td>@competitor.TablePosition.ToString("0")</td>
                <td>@competitor.Status</td>
            </tr>
        }
        </tbody>
    </table>
</div>
