@model SalesPortal.Web.Models.Cup.AdminCupCountriesViewModel
@{
    ViewData["Title"] = "Administración - Países";
}

<div class="admin-compact-header">
    <div>
        <span class="eyebrow">Administración de copa</span>
        <h2>Países</h2>
        <p>Agrega, modifica o elimina países desde una vista compacta.</p>
    </div>
    <div class="admin-module-actions">
        <a class="btn btn-secondary" asp-action="Players">Jugadores</a>
        <a class="btn btn-secondary" asp-action="Matches">Partidos</a>
    </div>
</div>

<section class="admin-workspace" data-admin-editor-scope>
    <div class="cup-card admin-list-panel">
        <div class="admin-panel-heading">
            <div>
                <span class="eyebrow">Paso 1</span>
                <h3>Buscar y seleccionar</h3>
            </div>
            <span class="admin-record-count" data-admin-grid-count>@Model.Countries.Count registros</span>
        </div>
        <div class="admin-table-toolbar admin-table-toolbar-compact">
            <label class="admin-search-field">
                <span>Buscar país</span>
                <input type="search" placeholder="ID, código país, nombre o bandera" data-admin-grid-search />
            </label>
        </div>
        <div class="table-wrapper admin-table admin-table-compact" data-admin-editor-grid>
            <table>
                <thead><tr><th>ID</th><th>Código país</th><th>Nombre país</th><th>Bandera</th></tr></thead>
                <tbody>
                @foreach (var country in Model.Countries)
                {
                    var countryFlagUrl = string.IsNullOrWhiteSpace(country.CountryFlagFileName)
                        ? string.Empty
                        : Url.Content($"~/img/banderas/{System.Uri.EscapeDataString(country.CountryCode)}.png");

                    <tr class="admin-selectable-row" tabindex="0" data-summary-title="@country.CountryName" data-summary-detail="@country.CountryCode" data-field-code="@country.Code" data-field-country-code="@country.CountryCode" data-field-country-name="@country.CountryName" data-field-name="@country.Name">
                        <td class="text-strong">@country.Code</td>
                        <td><span class="admin-table-chip">@country.CountryCode</span></td>
                        <td>@country.CountryName</td>
                        <td>
                            <span class="table-country-flag-cell">
                                @if (!string.IsNullOrWhiteSpace(countryFlagUrl))
                                {
                                    <img class="table-country-flag" src="@countryFlagUrl" alt="Bandera de @country.CountryName" title="@country.CountryName" />
                                }
                                else
                                {
                                    <span class="table-country-flag-placeholder" title="Sin bandera">--</span>
                                }
                                <span class="visually-hidden">@country.CountryName</span>
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <aside class="cup-card admin-module-card admin-editor-card admin-editor-panel" aria-labelledby="country-editor-title">
        <div class="admin-panel-heading admin-editor-heading">
            <div>
                <span class="eyebrow">Paso 2</span>
                <h3 id="country-editor-title">Agregar / editar país</h3>
            </div>
            <span class="admin-status-pill" data-admin-editor-status>Sin selección</span>
        </div>
        <div class="admin-selected-summary admin-selected-summary-compact" data-admin-selected-summary aria-live="polite">
            <span>País</span>
            <strong>Ningún registro seleccionado</strong>
        </div>
        <p class="admin-selection-help" data-admin-editor-help>Selecciona una fila o crea un registro nuevo.</p>
        <form asp-action="SaveCountry" method="post" class="cup-form admin-compact-form" data-admin-editor-form>
            @Html.AntiForgeryToken()
            <div class="form-field is-readonly">
                <label asp-for="Country.Code">ID interno</label>
                <input asp-for="Country.Code" class="cup-input" placeholder="ID" disabled data-admin-field="code" data-locked="true" data-generated-on-create="true" />
            </div>
            <div class="form-field">
                <label asp-for="Country.CountryCode">Código país</label>
                <input asp-for="Country.CountryCode" class="cup-input" placeholder="ECU" maxlength="3" disabled data-admin-field="countryCode" />
            </div>
            <div class="form-field form-field-wide">
                <label asp-for="Country.CountryName">Nombre país</label>
                <input asp-for="Country.CountryName" class="cup-input" placeholder="Ecuador" disabled data-admin-field="countryName" />
            </div>
            @* <div class="form-field form-field-wide">
                <label asp-for="Country.Name">Nombre SAP</label>
                <input asp-for="Country.Name" class="cup-input" placeholder="Opcional" disabled data-admin-field="name" />
            </div> *@
            <div class="admin-form-actions">
                <button type="button" class="btn btn-light" data-admin-editor-new>Nuevo</button>
                <button type="button" class="btn btn-light" data-admin-editor-clear disabled>Limpiar</button>
                <button type="submit" class="btn btn-primary" disabled data-admin-editor-submit>Guardar</button>
            </div>
        </form>
        <form asp-action="DeleteCountry" method="post" class="admin-delete-form" data-admin-delete-form onsubmit="return confirm('¿Eliminar este país?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="code" data-admin-delete-key />
            <button type="submit" class="btn btn-red" data-admin-delete-submit disabled>Eliminar país</button>
        </form>
    </aside>
</section>
